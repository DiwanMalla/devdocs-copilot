NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=replace_with_a_random_32_character_secret

# Optional. Raises GitHub API rate limits from 60/hr to 5,000/hr.
GITHUB_TOKEN=

# Required for Phase 2 chunk embeddings and semantic search.
OPENROUTER_API_KEY=

# Optional safe fallback model used only before OpenRouter starts streaming.
OPENROUTER_CHAT_FALLBACK_MODEL=
